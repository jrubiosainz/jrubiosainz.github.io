---
interface Props { id: string; class?: string; }
const { id, class: className } = Astro.props;
---
<svg id={id} class:list={["companion", className]} viewBox="0 0 560 610" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <defs>
    <linearGradient id={`${id}-shell`} x1="155" y1="250" x2="415" y2="475" gradientUnits="userSpaceOnUse"><stop stop-color="#ffb18b"/><stop offset=".5" stop-color="#ff7958"/><stop offset="1" stop-color="#dc503e"/></linearGradient>
    <linearGradient id={`${id}-head`} x1="142" y1="120" x2="410" y2="270" gradientUnits="userSpaceOnUse"><stop stop-color="#ebe4ff"/><stop offset="1" stop-color="#9e94de"/></linearGradient>
    <linearGradient id={`${id}-visor`} x1="155" y1="155" x2="390" y2="230" gradientUnits="userSpaceOnUse"><stop stop-color="#3c3c59"/><stop offset="1" stop-color="#171d30"/></linearGradient>
    <filter id={`${id}-shadow`} x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="9"/></filter>
    <pattern id={`${id}-grid`} width="14" height="14" patternUnits="userSpaceOnUse"><path d="M14 0H0V14" stroke="#fff" stroke-opacity=".3" stroke-width=".5"/></pattern>
  </defs>
  <ellipse class="ground" cx="286" cy="561" rx="125" ry="16" fill="#252636" opacity=".15" filter={`url(#${id}-shadow)`}/>
  <g class="limbs" stroke="#252638" stroke-width="3" stroke-linejoin="round">
    <g class="leg-left"><path d="M220 431L208 499L237 513L262 445" fill="#b2a5f3"/><path d="M213 473L250 487M210 483L246 497"/><path d="M209 493C182 496 157 515 161 531C165 546 212 544 239 527L237 510Z" fill="#f4efe5"/><path d="M164 526Q198 536 238 516" stroke="#9291a5"/></g>
    <g class="leg-right"><path d="M307 445L326 512L357 504L350 433" fill="#b2a5f3"/><path d="M321 483L355 475M325 494L356 486"/><path d="M327 508L354 496C386 501 412 521 406 535C398 550 348 544 330 532Z" fill="#f4efe5"/><path d="M332 524Q373 540 405 530" stroke="#9291a5"/></g>
    <g class="arm-left"><path d="M177 305C126 309 128 349 104 359" stroke="#252638" stroke-width="29"/><path d="M177 305C126 309 128 349 104 359" stroke="#b2a5f3" stroke-width="23"/><path d="M143 316L159 332M134 328L151 342M127 341L144 353" stroke-width="2"/><circle cx="94" cy="363" r="25" fill="#f4efe5"/><path d="M72 365L57 352M79 343L72 326M99 341L103 325" stroke-width="10" stroke-linecap="round"/><circle cx="94" cy="363" r="9" fill="#ff8d66"/></g>
    <g class="arm-right"><path d="M377 305C431 320 437 262 460 260" stroke="#252638" stroke-width="29"/><path d="M377 305C431 320 437 262 460 260" stroke="#b2a5f3" stroke-width="23"/><path d="M414 309L420 288M426 299L431 280M435 285L444 270" stroke-width="2"/><circle cx="476" cy="250" r="26" fill="#f4efe5"/><path d="M490 230L504 214M503 247L520 241M476 224L476 205" stroke-width="10" stroke-linecap="round"/><circle cx="476" cy="250" r="9" fill="#ff8d66"/></g>
  </g>
  <g class="chassis" stroke="#252638" stroke-width="3">
    <path d="M186 269L365 264C390 299 400 396 366 440C330 469 227 474 189 439C164 412 163 313 186 269Z" fill={`url(#${id}-shell)`}/>
    <path d="M191 282C177 337 178 406 201 431" stroke="#ffc5a4" stroke-width="7" stroke-linecap="round"/>
    <path d="M365 274Q396 372 366 432" stroke="#a23835" opacity=".5" stroke-width="10"/>
    <path d="M199 285Q277 312 367 280M183 418Q280 450 376 416" opacity=".35"/>
    <rect x="215" y="324" width="117" height="70" rx="20" fill="#f6eddf"/>
    <rect x="226" y="335" width="71" height="47" rx="11" fill="#282a3e"/>
    <path d="M236 360H248L254 348L263 371L273 352L280 360H287" stroke="#d4e98a" stroke-width="2" stroke-linecap="round"/>
    <circle cx="315" cy="348" r="6" fill="#b3a6f1"/>
    <path d="M310 367H320M310 374H320" stroke-width="2"/>
    <circle cx="201" cy="308" r="3" fill="#f6eddf"/><circle cx="355" cy="308" r="3" fill="#f6eddf"/>
    <path d="M257 412H289" stroke="#752f31" stroke-width="5" stroke-linecap="round"/>
    <path d="M252 270V244H306V268" fill="#f6eddf"/>
  </g>
  <g class="face" stroke="#252638" stroke-width="3">
    <path d="M144 151C145 117 379 105 399 144L407 226C396 265 166 276 149 241Z" fill={`url(#${id}-head)`}/>
    <path d="M155 147Q270 116 385 145" stroke="#fff9ed" stroke-opacity=".8" stroke-width="6" stroke-linecap="round"/>
    <path d="M169 159C184 141 360 139 377 157L382 218C367 245 183 251 170 225Z" fill={`url(#${id}-visor)`}/>
    <path d="M180 160Q264 143 371 159" stroke="#666581" stroke-width="2"/>
    <rect class="eye" x="215" y="176" width="20" height="36" rx="10" fill="#e0f19a" stroke="none"/>
    <rect class="eye" x="313" y="172" width="20" height="36" rx="10" fill="#e0f19a" stroke="none"/>
    <path d="M261 213Q274 222 286 212" stroke="#e0f19a" stroke-width="3" stroke-linecap="round"/>
    <path d="M145 179H135V212H148M400 170L413 173V207H405" fill="#ff8662"/>
    <circle cx="274" cy="251" r="4" fill="#ff8662" stroke-width="1.5"/>
  </g>
  <g class="spark">
    <path d="M278 119L275 88" stroke="#252638" stroke-width="4"/>
    <circle cx="274" cy="81" r="12" fill="#ff8760" stroke="#252638" stroke-width="3"/>
    <path d="M469 156V126M454 141H484" stroke="#d4e98a" stroke-width="5" stroke-linecap="round"/>
    <path d="M103 202V182M93 192H113" stroke="#ae9eea" stroke-width="3" stroke-linecap="round"/>
    <path d="M279 40V25M245 52L235 42M303 48L314 36" stroke="#ff8760" stroke-width="3" stroke-linecap="round"/>
    <path d="M418 418L428 400L437 418L456 426L437 435L428 453L419 435L400 426Z" fill="#d4e98a" stroke="#252638" stroke-width="2"/>
  </g>
</svg>
