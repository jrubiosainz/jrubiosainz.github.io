---
import "@fontsource-variable/space-grotesk";
import "@fontsource-variable/manrope";
import "@fontsource/ibm-plex-mono/400.css";
import { copy, identity, type Language } from "../content/site";
const { lang } = Astro.props as { lang: Language };
const t = copy[lang];
const canonical = `${identity.site}${lang === "es" ? "/es/" : "/"}`;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#07090d" />
    <title>{t.metaTitle}</title>
    <meta name="description" content={t.metaDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={`${identity.site}/`} />
    <link rel="alternate" hreflang="es" href={`${identity.site}/es/`} />
    <link rel="alternate" hreflang="x-default" href={`${identity.site}/`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={t.metaTitle} />
    <meta property="og:description" content={t.metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${identity.site}/portrait.jpg`} />
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <header><a href="#main" class="wordmark">JRS<span> / </span></a><span class="serial">HUMAN / SYSTEM — 001</span><nav aria-label={t.language}><a href="/" aria-current={lang === "en" ? "page" : undefined} lang="en">EN</a><a href="/es/" aria-current={lang === "es" ? "page" : undefined} lang="es">ES</a></nav></header>
    <main id="main">
      <p class="identity">{identity.name}<span>{t.role} — {t.discipline}</span></p>
      <h1>{t.hero}</h1>
      <p class="lead">{t.lead}</p>
      <a class="contact" href={identity.linkedin}>{t.linkedin}<span aria-hidden="true">↗</span></a>
      <div class="void-line" aria-hidden="true"></div>
    </main>
    <footer><span>© {identity.name}</span><span>{t.independent}</span><a href={identity.linkedin}>LinkedIn ↗</a></footer>
  </body>
</html>
<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { background: #07090d; color: #edf0f3; }
  :global(body) { margin: 0; font-family: "Manrope Variable", sans-serif; min-height: 100svh; }
  :global(a) { color: inherit; text-decoration: none; }
  :global(:focus-visible) { outline: 2px solid #a0deed; outline-offset: 6px; }
  .skip { position: absolute; top: 0; left: 12px; transform: translateY(-150%); padding: 12px; background: #edf0f3; color: #07090d; z-index: 4; }
  .skip:focus { transform: none; }
  header { height: 90px; margin: 0 6%; border-bottom: 1px solid #353c44; display: flex; align-items: center; gap: 50px; }
  .wordmark { font: 600 23px "Space Grotesk Variable", sans-serif; letter-spacing: -.05em; }
  .wordmark span { color: #a0deed; }
  .serial, nav, footer { font: 10px "IBM Plex Mono", monospace; letter-spacing: .07em; color: #b3bdc6; }
  nav { margin-left: auto; display: flex; gap: 20px; }
  nav a { min-width: 30px; padding: 12px 0; }
  nav [aria-current] { color: #a0deed; }
  main { padding: 90px 8% 100px; min-height: calc(100svh - 180px); overflow: hidden; position: relative; }
  .identity { font-size: 19px; position: relative; z-index: 1; }
  .identity span { display: block; font-size: 12px; margin-top: 12px; color: #b3bdc6; }
  h1 { font: 500 clamp(52px, 9vw, 145px)/.96 "Space Grotesk Variable", sans-serif; letter-spacing: -.075em; white-space: pre-line; margin: 52px 0 35px; position: relative; z-index: 1; }
  .lead { white-space: pre-line; color: #b3bdc6; font-size: 18px; line-height: 1.7; }
  .contact { display: inline-flex; gap: 55px; align-items: center; border-bottom: 1px solid #67747e; margin-top: 30px; padding-bottom: 15px; font-size: 13px; }
  .contact span { color: #a0deed; font-size: 22px; }
  .void-line { position: absolute; width: 45%; height: 140%; right: -12%; top: -35%; border-left: 1px solid #52616d; transform: rotate(25deg); opacity: .3; }
  footer { margin: 0 6%; border-top: 1px solid #353c44; min-height: 90px; display: flex; align-items: center; gap: 30px; }
  footer a { margin-left: auto; }
  @media(max-width:600px) { header { height:75px; gap:20px; } .serial { display:none; } main { padding:60px 7%; } .identity { font-size:17px; } .identity span { font-size:11px; line-height:1.7; max-width:280px; } h1 { font-size:12vw; } .lead { font-size:16px; } footer { flex-wrap:wrap; font-size:8px; gap:15px; padding:20px 0; } footer a { margin-left:0; } .contact { font-size:11px; gap:25px; } }
</style>
