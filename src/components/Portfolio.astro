---
import "@fontsource-variable/space-grotesk";
import "@fontsource-variable/manrope";
import "@fontsource/ibm-plex-mono/400.css";
import "../styles/global.css";
import HeroVisual from "./HeroVisual.astro";
import Companion from "./Companion.astro";
import ProjectArt from "./ProjectArt.astro";
import { copy, identity, projects, experiments, type Language } from "../content/site";

const { lang } = Astro.props as { lang: Language };
const t = copy[lang];
const canonical = new URL(lang === "es" ? "/es/" : "/", identity.site);
const chapters = [{ id: "build", title: t.build }, { id: "work", title: t.work }, { id: "about", title: t.about }, { id: "contact", title: t.contact }];
const phases = [t.buildPhase0, t.buildPhase1, t.buildPhase2, t.buildPhase3];
const moves = [
  { part: "chassis", property: "y: 90", color: "coral" },
  { part: "limbs", property: "scale: 0", color: "lilac" },
  { part: "face", property: "y: -60", color: "lilac" },
  { part: "spark", property: "scale: 0", color: "lime" },
];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f4f1e9" />
    <title>{t.metaTitle}</title>
    <meta name="description" content={t.metaDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={`${identity.site}/`} />
    <link rel="alternate" hreflang="es" href={`${identity.site}/es/`} />
    <link rel="alternate" hreflang="x-default" href={`${identity.site}/`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={t.metaTitle} />
    <meta property="og:description" content={t.metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === "es" ? "es_ES" : "en_US"} />
    <meta property="og:locale:alternate" content={lang === "es" ? "en_US" : "es_ES"} />
    <meta property="og:image" content={`${identity.site}/social-preview${lang === "es" ? "-es" : ""}.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.metaTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", "@type": "Person", name: identity.name, url: identity.site, jobTitle: "Cloud Solution Architect, AI & Apps", worksFor: { "@type": "Organization", name: "Microsoft" }, sameAs: [identity.github, identity.linkedin, identity.huggingface] })} />
    <script is:inline>
      try {
        const url = new URL(location.href);
        const explicit = url.searchParams.get("lang");
        if (explicit === "en" || explicit === "es") localStorage.setItem("portfolio-language", explicit);
        const navigation = performance.getEntriesByType("navigation")[0];
        if (url.pathname === "/" && !explicit && navigation?.type !== "back_forward" && localStorage.getItem("portfolio-language") === "es") {
          location.replace("/es/" + url.search + url.hash);
        }
        const motion = localStorage.getItem("portfolio-motion");
        document.documentElement.dataset.motion = motion === "off" || matchMedia("(prefers-reduced-motion: reduce)").matches ? "off" : "on";
      } catch {
        // Storage can be unavailable in privacy mode; the accessible defaults still work.
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    <header class="header">
      <a class="brand" href="#top" aria-label={t.home}><span class="brand-mark" aria-hidden="true">j<span>r</span>s<span class="brand-dot">.</span></span><span class="brand-name">JESÚS RUBIO SAINZ</span></a>
      <nav class="desktop-nav" aria-label={t.navLabel}>{chapters.slice(0, 3).map(chapter => <a href={`#${chapter.id}`}>{chapter.title}</a>)}</nav>
      <div class="header-tools">
        <button id="motion-toggle" class="motion-toggle mono" type="button" aria-label={t.motionLabel} aria-pressed="true" data-on={t.motionOn} data-off={t.motionOff} hidden><span class="motion-indicator" aria-hidden="true"></span><span class="motion-text">{t.motionOn}</span></button>
        <details class="language-console">
          <summary aria-label={t.languageLabel}><span aria-hidden="true" class="language-glyph">〈/〉</span><span>{lang.toUpperCase()}</span><span class="tiny-chevron" aria-hidden="true">⌄</span></summary>
          <div class="language-panel">
            <p class="mono"><span class="status-dot"></span> {t.languageCommand}</p>
            <span class="language-hint">{t.languageHint}</span>
            <a href="/?lang=en" lang="en" hreflang="en" data-language="en" aria-current={lang === "en" ? "page" : undefined}><span class="mono">01</span> English <span aria-hidden="true">{lang === "en" ? "●" : "↗"}</span></a>
            <a href="/es/" lang="es" hreflang="es" data-language="es" aria-current={lang === "es" ? "page" : undefined}><span class="mono">02</span> Español <span aria-hidden="true">{lang === "es" ? "●" : "↗"}</span></a>
            <code>world.setLanguage("{lang}");</code>
          </div>
        </details>
      </div>
    </header>
    <aside class="chapter-rail" aria-label={t.navLabel}>
      <a href="#top" class="rail-home active" aria-label={t.home}><span aria-hidden="true">✳</span></a>
      {chapters.map((chapter, index) => <a href={`#${chapter.id}`} aria-label={chapter.title}><span class="rail-line"></span><span class="rail-number mono">0{index + 1}</span><span class="rail-tooltip">{chapter.title}</span></a>)}
    </aside>
    <div class="reading-track" aria-hidden="true"><div id="reading-progress"></div></div>
    <main id="main">
      <section id="top" class="hero" aria-labelledby="hero-heading">
        <div class="hero-meta mono"><span><span class="status-dot"></span>{t.introLabel}</span><span class="hero-edition">VOL. 01 — ∞</span></div>
        <div class="hero-stage">
          <div class="hero-type"><p class="hero-role"><strong>{identity.name}</strong>{t.role}<span>{t.roleDetail}</span></p><h1 id="hero-heading"><span>{t.heroFirst}</span><span>{t.heroSecond}<i aria-hidden="true">✳</i></span></h1></div>
          <HeroVisual lang={lang} />
          <div class="hero-copy"><p class="hero-description">{t.heroDescription}</p><p class="hero-personal">{t.heroPersonal}</p><a class="round-link" href="#build"><span class="round-icon" aria-hidden="true">↓</span>{t.explore}</a></div>
          <div class="hero-note"><svg viewBox="0 0 100 60" aria-hidden="true"><path d="M4 54Q5 5 77 16M60 2L79 16L59 30" fill="none" stroke="currentColor" stroke-width="1.5"/></svg><span>{t.heroAside}</span></div>
        </div>
        <div class="hero-footer"><p class="mono">{t.edition}</p><div class="social-small"><a href={identity.linkedin}>LinkedIn <span aria-hidden="true">↗</span></a><a href={identity.github}>GitHub <span aria-hidden="true">↗</span></a></div><a href="#build" class="scroll-cue mono">{t.scroll}<span aria-hidden="true">↓</span></a></div>
      </section>
      <section id="build" class="build-section dark-section" aria-labelledby="build-heading">
        <div class="build-intro section-intro"><p class="eyebrow">{t.introIndex}</p><h2 id="build-heading">{t.buildTitle}</h2><div class="build-description"><p>{t.buildDescription}</p><span class="mono">{t.buildHint}</span></div></div>
        <div class="build-runway">
          <div class="build-sticky">
            <div class="compiler">
              <div class="compiler-bar"><span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span><span class="mono">{t.buildFilename}</span><span class="compiler-symbol" aria-hidden="true">↗</span></div>
              <div class="compiler-code">
                <div class="code-line declaration"><span class="line-no">01</span><code><span class="syntax-lilac">import</span> {"{ gsap }"} <span class="syntax-lilac">from</span> <span class="syntax-lime">"gsap"</span>;</code></div>
                <div class="code-line declaration"><span class="line-no">02</span><code><span class="syntax-lilac">const</span> world = gsap.<span class="syntax-coral">timeline</span>();</code></div>
                <div class="code-line blank"><span class="line-no">03</span><code aria-hidden="true">&nbsp;</code></div>
                {moves.map((move, i) => <div class="code-step" data-step={i}><span class="line-no">0{i + 4}</span><code>world.<span class="syntax-coral">from</span>(<span class={`syntax-${move.color}`}>"#idea .{move.part}"</span>,<br/><span class="code-indent">{"{ "}<span>{move.property}</span>, opacity: <span class="syntax-lime">0</span>{" });"}</span></code><span class="step-check" aria-hidden="true">✓</span></div>)}
              </div>
              <div class="compiler-bottom mono"><span><span class="status-dot"></span> {t.buildStatus}</span><span class="compile-percent">100%</span></div>
              <p class="compiler-caption mono">{t.buildFootnote}</p>
            </div>
            <div class="build-output">
              <div class="blueprint-grid"></div>
              <div class="output-orbit"></div>
              <div class="output-label mono">{t.output}<span>001</span></div>
              <div class="build-model"><Companion id="idea" /></div>
              <span class="axis-label axis-y mono">Y</span><span class="axis-label axis-x mono">X</span>
              <div class="phase-label mono" data-phases={JSON.stringify(phases)}>{t.buildComplete}</div>
              <div class="build-meter" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
            </div>
            <p class="static-note mono">{t.buildStatic}</p>
          </div>
        </div>
        <div class="build-outro"><span class="mono">{"</idea>"}</span><p>{t.buildComplete}</p><span aria-hidden="true">↘</span></div>
      </section>
      <section id="work" class="work-section" aria-labelledby="work-heading">
        <div class="work-intro section-intro"><p class="eyebrow">{t.workIndex}</p><h2 id="work-heading">{t.workTitle}<span class="title-spark" aria-hidden="true">✳</span></h2><p class="work-description">{t.workDescription}</p></div>
        <div class="projects">{projects.map((project, index) => <article class:list={["project", `project-${index + 1}`]} aria-labelledby={`title-${project.id}`}>
          <div class="project-image"><ProjectArt art={project.art} id={project.id} label={t.projectArtLabel} lang={lang} /><span class="project-number mono">0{index + 1}</span></div>
          <div class="project-content"><p class="project-category mono">{project.category[lang]}</p><h3 id={`title-${project.id}`}>{project.id === "reachy-mini" ? t.reachyTitle : project.title}</h3><p class="project-description">{project.description[lang]}</p><p class="project-note">{project.note[lang]}</p><ul class="project-tags" aria-label={lang === "es" ? "Tecnologías" : "Technologies"}>{project.tags.map(tag => <li>{tag === "AI art" && lang === "es" ? "Arte con IA" : tag === "Pixel art" && lang === "es" ? "Arte de píxel" : tag}</li>)}</ul><p class="project-status mono"><span class="status-dot"></span>{project.status[lang]}</p><a class="project-link" href={project.url}>{t.projectLink}<span aria-hidden="true">↗</span><span class="sr-only"> — {project.title}</span></a></div>
        </article>)}</div>
        <div class="more-experiments"><p class="eyebrow">{t.moreLabel}</p><h3>{t.moreTitle}</h3>{experiments.map((experiment, index) => <a href={experiment.url} class="experiment"><span class="mono experiment-index">0{index + 5}</span><span><strong>{experiment.title}</strong><span class="experiment-description">{experiment.description[lang]}</span></span><span class="mono experiment-type">{experiment.type[lang]}</span><span class="experiment-arrow" aria-hidden="true">↗</span></a>)}</div>
        <a class="all-work" href={identity.github}><span>{t.allWork}</span><span aria-hidden="true">↗</span></a>
      </section>
      <section id="about" class="about-section" aria-labelledby="about-heading">
        <div class="section-intro"><p class="eyebrow">{t.aboutIndex}</p><h2 id="about-heading">{t.aboutTitle}</h2></div>
        <div class="about-grid">
          <div class="human-poster" aria-hidden="true"><span class="poster-corner mono">{lang === "es" ? "HUMANO / NO GENERADO" : "HUMAN / NOT GENERATED"}</span><span class="human-letters">J<span>R</span>S<span class="poster-dot">.</span></span><svg viewBox="0 0 400 230"><path d="M26 165C82 44 237 2 322 77C401 151 251 232 137 181C65 150 98 68 175 44" fill="none" stroke="#353247" stroke-width="2"/><path d="M293 163L354 137M325 118L337 180" stroke="#353247" stroke-width="2"/><path d="M87 86L106 43L110 81" fill="none" stroke="#353247" stroke-width="2"/></svg><span class="poster-bottom mono">{lang === "es" ? "MENOS EGO." : "LESS EGO."}<br/>{lang === "es" ? "MÁS «¿Y SI…?»." : "MORE “WHAT IF”."}</span><span class="poster-star">✳</span></div>
          <div class="about-copy"><p class="about-lead">{t.aboutLead}</p><p>{t.aboutDescription}</p><a class="text-link" href={identity.linkedin}>{t.profileLink}<span aria-hidden="true">↗</span></a><div class="philosophy"><p class="mono">{t.philosophyTitle}</p><blockquote>{t.philosophy}</blockquote></div></div>
        </div>
        <div class="principles">{[[t.anchorOne, t.anchorOneText], [t.anchorTwo, t.anchorTwoText], [t.anchorThree, t.anchorThreeText]].map(([title, text], i) => <div><span class="mono">0{i + 1}</span><h3>{title}</h3><p>{text}</p></div>)}</div>
        <aside class="field-note"><span class="field-note-symbol" aria-hidden="true">↳</span><div><p class="mono">{t.fieldNote}</p><p>{t.fieldNoteText}</p><a href="https://www.linkedin.com/posts/jrubiosainz_stable-diffusion-turbo-generates-images-activity-7137504583320256512--3Y3">{t.fieldNoteLink} <span aria-hidden="true">↗</span></a></div></aside>
      </section>
      <footer id="contact" class="contact-section dark-section" aria-labelledby="contact-heading">
        <div class="credits-orbit" aria-hidden="true"></div>
        <p class="eyebrow">{t.creditsIndex}</p>
        <h2 id="contact-heading">{t.creditsTitle}<span aria-hidden="true">✳</span></h2>
        <p class="contact-description">{t.creditsDescription}</p>
        <div class="contact-links"><a href={identity.linkedin}>LinkedIn <span aria-hidden="true">↗</span></a><a href={identity.github}>GitHub <span aria-hidden="true">↗</span></a><a href={identity.huggingface}>Hugging Face <span aria-hidden="true">↗</span></a></div>
        <div class="credits-list"><div><span>{t.creditsRole}</span><span>{identity.name}</span></div><div><span>{t.creditsArt}</span><span>{t.creditsArtValue}</span></div><div><span>{t.creditsThanks}</span><span>{t.creditsThanksValue}</span></div></div>
        <p class="closing">{t.closing}</p>
        <a class="replay mono" href="#build"><span aria-hidden="true">↺</span> {t.replay}</a>
        <div class="footer-bottom"><a class="brand-mark" href="#top" aria-label={t.backTop}>jrs.</a><p>{t.independent}</p><span class="mono">{t.madeWith}</span><a href="#top" class="back-top" aria-label={t.backTop}>↑</a></div>
      </footer>
    </main>
    <script src="../scripts/experience.ts"></script>
  </body>
</html>
