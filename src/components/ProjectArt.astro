---
import type { Art, Language } from "../content/site";
interface Props { art: Art; label: string; id: string; lang: Language; }
const { art, label, id, lang } = Astro.props;
---
<div class:list={["project-art", `art-${art}`]} role="img" aria-label={label}>
  <svg viewBox="0 0 720 550" fill="none" aria-hidden="true">
    <defs>
      <pattern id={`${id}-dots`} width="28" height="28" patternUnits="userSpaceOnUse"><circle cx="1" cy="1" r="1" fill="currentColor" opacity=".18"/></pattern>
      <linearGradient id={`${id}-paper`} x1="250" y1="120" x2="480" y2="420" gradientUnits="userSpaceOnUse"><stop stop-color="#fff8e9"/><stop offset="1" stop-color="#dacfb6"/></linearGradient>
      <linearGradient id={`${id}-glass`} x1="200" y1="160" x2="500" y2="380" gradientUnits="userSpaceOnUse"><stop stop-color="#aaa0ef"/><stop offset="1" stop-color="#7366b1"/></linearGradient>
    </defs>
    <rect width="720" height="550" fill={`url(#${id}-dots)`}/>
    {art === "atlas" && <>
      <circle cx="361" cy="274" r="198" fill="#a6a0d4"/>
      <ellipse cx="360" cy="408" rx="203" ry="49" fill="#292b3d" opacity=".12"/>
      <g class="scene-base">
      <path d="M132 346L299 423L583 311L416 234Z" fill="#e9dfc9" stroke="#302e41" stroke-width="2"/>
      <path d="M132 346V363L299 442L583 330V311L299 423Z" fill="#aaa08e" stroke="#302e41" stroke-width="2"/>
      <path d="M215 320L293 356L515 271L437 235Z" fill="#6e6587" stroke="#302e41" stroke-width="2"/>
      <path d="M227 310L299 343L505 264L433 231Z" fill="#fff8e9" stroke="#302e41" stroke-width="2"/>
      <path d="M238 274L310 307L493 237L421 204Z" fill="#f3ebe0" stroke="#302e41" stroke-width="2"/>
      <path d="M249 237L321 270L482 209L410 176Z" fill="#d7efa2" stroke="#302e41" stroke-width="2"/>
      </g><g class="scene-object">
      <path d="M232 174L364 226L502 174L370 122Z" fill="#fff8e9" stroke="#302e41" stroke-width="2"/>
      <path d="M251 174L371 218M272 167L393 210M294 159L415 202M316 152L437 194M338 144L459 186M360 136L481 178" stroke="#b5b0cd" stroke-width="1"/>
      <path d="M300 147L426 201" stroke="#e79a9a" stroke-width="1"/>
      <path d="M355 167L368 135L391 151L378 183L355 175Z" fill="#e3dda9" stroke="#302e41" stroke-width="2"/>
      <path d="M365 163L379 150M360 169L374 176" stroke="#302e41" stroke-width="2"/>
      <path d="M330 186L353 175M375 186L394 195M389 160L414 149M407 139L419 158" stroke="#302e41" stroke-width="3" stroke-linecap="round"/>
      </g><g class="scene-detail">
      <path d="M183 284L211 148L223 137L230 152L201 288L189 305Z" fill="#fc9b79" stroke="#302e41" stroke-width="2"/>
      <path d="M183 284L189 305L201 288Z" fill="#f8efdd" stroke="#302e41" stroke-width="2"/>
      <path d="M187 298L189 305L192 299" fill="#302e41"/>
      <path d="M213 156L187 282M224 157L199 285" stroke="#e06949" stroke-width="2"/>
      </g>
      <path d="M255 237V285M475 212V261M315 270V311" stroke="#302e41" stroke-dasharray="4 7"/>
      <path class="scene-path" d="M300 122V76H440M518 259H584V183M230 376H150V422" stroke="#302e41" stroke-width="1"/>
      <circle cx="300" cy="122" r="4" fill="#302e41"/><circle cx="518" cy="259" r="4" fill="#302e41"/>
      <text x="308" y="68" fill="#302e41" font-size="11" font-family="monospace">{lang === "es" ? "IDEA → PAPEL → AVENTURA" : "IDEA → PAPER → ADVENTURE"}</text>
      <path d="M183 168L189 148L195 168L215 174L195 180L189 200L183 180L163 174Z" fill="#f9f2e2"/>
    </>}
    {art === "signal" && <>
      <circle cx="357" cy="270" r="201" stroke="#8c89ab" stroke-width="1"/>
      <circle cx="357" cy="270" r="170" stroke="#8c89ab" stroke-dasharray="3 8"/>
      <ellipse cx="359" cy="442" rx="175" ry="29" fill="#171b2b" opacity=".2"/>
      <g class="scene-object">
      <path d="M249 190L309 167H463L486 189V347L462 371H280L249 344Z" fill="#8d83c8" stroke="#222638" stroke-width="3"/>
      <rect x="234" y="189" width="231" height="182" rx="30" fill="#e9e2d1" stroke="#222638" stroke-width="3"/>
      <rect x="252" y="208" width="151" height="120" rx="18" fill="#25293e" stroke="#222638" stroke-width="3"/>
      <path class="scene-path" d="M267 269H279L287 245L298 294L309 235L321 307L334 257L345 277L355 254L365 267H386" stroke="#d9eea0" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
      <circle cx="433" cy="235" r="11" fill="#ff8d65" stroke="#222638" stroke-width="2"/>
      <circle cx="433" cy="270" r="7" fill="#a99be0" stroke="#222638" stroke-width="2"/>
      <path d="M425 306H442M425 314H442M270 348H318" stroke="#222638" stroke-width="3" stroke-linecap="round"/>
      </g>
      <path class="scene-base" d="M318 369V395L280 418H424L384 395V371" fill="#d7cebc" stroke="#222638" stroke-width="3"/>
      <g class="scene-detail">
      <path d="M319 183L310 100Q355 80 399 100L391 183Z" fill="#29283d" stroke="#222638" stroke-width="3"/>
      <path d="M311 149Q355 160 396 148V170Q354 183 314 170Z" fill="#aa9add" stroke="#222638" stroke-width="2"/>
      <ellipse cx="354" cy="184" rx="77" ry="14" fill="#39364c" stroke="#222638" stroke-width="3"/>
      <path d="M335 394L311 379V410L335 399L359 410V379Z" fill="#fa9771" stroke="#222638" stroke-width="2"/>
      </g>
      <path d="M221 114Q202 137 220 160M195 98Q164 137 195 175M480 204Q512 242 483 281M507 187Q553 241 510 297" stroke="#f1eada" stroke-width="3" stroke-linecap="round"/>
      <path d="M139 323H203M163 311V335M175 300V345M186 311V335" stroke="#f1eada" stroke-width="2"/>
      <text x="469" y="395" fill="#f1eada" font-size="11" font-family="monospace">{lang === "es" ? "ESCUCHA. CONECTA." : "LISTEN. CONNECT."}</text>
      <circle cx="529" cy="123" r="6" fill="#d9eea0"/>
    </>}
    {art === "garden" && <>
      <circle cx="359" cy="265" r="190" fill="#d5dfa9"/>
      <ellipse cx="366" cy="438" rx="199" ry="41" fill="#3a493d" opacity=".13"/>
      <g class="scene-base">
      <path d="M138 367L359 268L584 365L363 467Z" fill="#c4d3a4" stroke="#6f8263" stroke-width="1.5"/>
      <path d="M193 391L415 292M249 417L471 316M304 441L527 341M190 343L416 443M247 316L473 416M302 292L528 390" stroke="#9eb38d" stroke-width="1"/>
      </g>
      <path class="scene-path" d="M222 380L302 343L372 373L486 323" stroke="#536f52" stroke-width="3" stroke-dasharray="6 8"/>
      <path d="M461 325L489 321L479 342" stroke="#536f52" stroke-width="3" stroke-linecap="round"/>
      <g class="scene-object">
      <path d="M304 271L294 319L314 346L290 368M367 272L378 324L359 348L389 363" stroke="#293c34" stroke-width="13" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M278 367L309 367M372 366L405 366" stroke="#293c34" stroke-width="17" stroke-linecap="round"/>
      <circle cx="299" cy="319" r="11" fill="#b1a2e4" stroke="#293c34" stroke-width="2"/>
      <circle cx="375" cy="322" r="11" fill="#b1a2e4" stroke="#293c34" stroke-width="2"/>
      <rect x="290" y="218" width="91" height="67" rx="24" fill="#f5ecdc" stroke="#293c34" stroke-width="3"/>
      <path d="M316 225V180H350V225" fill="#b1a2e4" stroke="#293c34" stroke-width="3"/>
      <path d="M272 153C271 128 373 122 393 150L395 198Q341 223 277 202Z" fill="#fcac83" stroke="#293c34" stroke-width="3"/>
      <rect x="283" y="154" width="98" height="43" rx="16" fill="#293c34" transform="rotate(-4 283 154)"/>
      <circle cx="310" cy="172" r="10" fill="#bfe2a0"/><circle cx="355" cy="168" r="10" fill="#bfe2a0"/>
      <circle cx="311" cy="170" r="4" fill="#293c34"/><circle cx="356" cy="166" r="4" fill="#293c34"/>
      <path d="M299 253H369" stroke="#aea69a" stroke-width="2"/>
      <path d="M333 136V108" stroke="#293c34" stroke-width="3"/><circle cx="333" cy="102" r="8" fill="#b1a2e4" stroke="#293c34" stroke-width="2"/>
      </g><g class="scene-detail">
      <path d="M444 281L453 252L463 281Z" fill="#fcac83" stroke="#293c34" stroke-width="2"/>
      <path d="M435 283H471" stroke="#293c34" stroke-width="3"/>
      <path d="M196 239V290M190 247L215 260L223 251M198 292L184 315M198 291L216 314" stroke="#6c8167" stroke-width="5" stroke-linecap="round"/><circle cx="197" cy="226" r="11" fill="#6c8167"/>
      </g>
      <path d="M157 353L206 327M521 251L558 267M385 73V54" stroke="#273b32" stroke-width="1.5"/>
      <circle cx="513" cy="151" r="21" fill="#f5edde"/><path d="M504 151H522M513 142V160" stroke="#273b32" stroke-width="2"/>
      <text x="152" y="482" fill="#273b32" font-size="11" font-family="monospace">{lang === "es" ? "UN POCO DE ESPACIO PARA LOS DEMÁS." : "A LITTLE ROOM FOR SOMEONE ELSE."}</text>
    </>}
    {art === "orbit" && <>
      <circle cx="360" cy="274" r="196" fill="#f5b397"/>
      <ellipse cx="362" cy="424" rx="170" ry="34" fill="#773e3e" opacity=".12"/>
      <ellipse cx="358" cy="269" rx="250" ry="78" stroke="#664343" stroke-width="1.5" transform="rotate(-26 358 269)"/>
      <g transform="rotate(-12 360 265)">
        <g class="scene-base">
        <rect x="233" y="98" width="259" height="341" rx="47" fill="#75699c" stroke="#34303e" stroke-width="3"/>
        <rect x="221" y="91" width="259" height="341" rx="43" fill="#cec2ee" stroke="#34303e" stroke-width="3"/>
        <rect x="244" y="120" width="211" height="182" rx="14" fill="#34303e" stroke="#34303e" stroke-width="3"/>
        <rect x="260" y="136" width="178" height="149" rx="5" fill="#c0d697"/>
        </g><g class="scene-object">
        <path d="M260 249H285V237H310V251H333V238H359V252H389V238H417V250H438V285H260Z" fill="#708655"/>
        <path d="M270 160H300V170H270M393 151H424V161H393" stroke="#e8edbf" stroke-width="8"/>
        <path d="M290 216V180H320V216M284 197H326M295 216V227M315 216V227" stroke="#38483b" stroke-width="8"/>
        <rect x="298" y="187" width="4" height="5" fill="#d9eabb"/><rect x="310" y="187" width="4" height="5" fill="#d9eabb"/>
        <path d="M368 220V189H400V220M360 206H408M374 220V231M394 220V231" stroke="#a06f58" stroke-width="8"/>
        <rect x="375" y="196" width="5" height="6" fill="#d9eabb"/><rect x="388" y="196" width="5" height="6" fill="#d9eabb"/>
        </g><g class="scene-detail">
        <path d="M280 321H302V338H319V359H302V376H280V359H263V338H280Z" fill="#34303e"/>
        <circle cx="414" cy="335" r="16" fill="#f18163" stroke="#34303e" stroke-width="2"/>
        <circle cx="378" cy="366" r="16" fill="#f18163" stroke="#34303e" stroke-width="2"/>
        <path d="M324 397H346M354 397H376" stroke="#776b95" stroke-width="6" stroke-linecap="round"/>
        </g>
      </g>
      <circle cx="169" cy="359" r="16" fill="#d6e995" stroke="#34303e" stroke-width="2"/>
      <path d="M510 132V111M500 121H521M189 224V210M181 217H197" stroke="#34303e" stroke-width="2"/>
      <text x="442" y="455" fill="#34303e" font-size="11" font-family="monospace">{lang === "es" ? "UN MUNDO EN EL BOLSILLO." : "A WORLD IN YOUR POCKET."}</text>
    </>}
    <path d="M25 48V25H48M672 25H695V48M25 502V525H48M672 525H695V502" stroke="currentColor" opacity=".45"/>
    <text x="35" y="50" fill="currentColor" opacity=".65" font-size="10" font-family="monospace">{lang === "es" ? "NOTAS DE CAMPO" : "FIELD NOTES"} / {id.toUpperCase()}</text>
    <text x="555" y="510" fill="currentColor" opacity=".65" font-size="10" font-family="monospace">FIG. {art.toUpperCase()}</text>
  </svg>
</div>
